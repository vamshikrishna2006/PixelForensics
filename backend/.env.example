# =========================
# Backend environment template
# =========================
# Copy to .env and fill in real values. Never commit real .env files.

# Application
APP_NAME=PixelForensics
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# JWT secret (must be long, random; rotate in production)
SECRET_KEY=please-change-me-to-a-long-random-string-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Local dev (default):
DATABASE_URL=sqlite:///./pixelforensics.db
# Production (Supabase Postgres):
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Supabase (production)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=images

# CORS — comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Upload limits
MAX_UPLOAD_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# Storage path (local dev only)
LOCAL_STORAGE_PATH=./storage

# Logging and monitoring
LOG_LEVEL=INFO
LOG_FILE=./logs/app.jsonl
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5
MONITORING_ENABLED=true
MONITOR_INTERVAL_SECONDS=300

# Alert delivery (leave blank to keep alerts dashboard-only)
# ALERT_WEBHOOK_URL is a Slack/Discord/generic HTTPS webhook. Never commit it.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TYPE=generic
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_SMTP_USER=
ALERT_EMAIL_SMTP_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_USE_TLS=true
ALERT_COOLDOWN_MINUTES=30
ALERT_MIN_SEVERITY=error

# Automated backups (database + local storage)
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_HOUR_UTC=2
BACKUP_CHECK_INTERVAL_MINUTES=60
BACKUP_RETENTION_DAYS=14
BACKUP_PG_DUMP_TIMEOUT_SECONDS=600
BACKUP_VERIFY_AFTER_RUN=true
# auto (pg_dump if installed, else read-only logical dump) | pg_dump | logical
BACKUP_POSTGRES_MODE=auto
# Isolated TEST database only. NEVER point this at production.
RESTORE_TEST_DATABASE_URL=

# Forensic algorithm version
FORENSIC_ALGORITHM_VERSION=1.0.0

# Default admin (created on first startup if no admin exists)
DEFAULT_ADMIN_EMAIL=admin@pixelforensics.com
DEFAULT_ADMIN_PASSWORD=Admin@12345
DEFAULT_ADMIN_USERNAME=admin

# Guest access mode – temporary anonymous access to real app
GUEST_ACCESS_MODE=false