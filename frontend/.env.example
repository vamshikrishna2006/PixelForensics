# Frontend environment template — copy to .env

# Backend API base URL
VITE_API_BASE_URL=http://localhost:8000

# Supabase (production only — safe to expose, anon key is public)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Application metadata
VITE_APP_NAME=PixelForensics
VITE_APP_VERSION=1.0.0
VITE_APP_TAGLINE=See the Noise. Verify the Image.